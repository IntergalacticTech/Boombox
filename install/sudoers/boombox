# /etc/sudoers.d/boombox — installed by install.sh (chmod 0440, validated with visudo).
#
# Lets the desktop user kick library scans and bounce mopidy from the touch
# UI without typing a password. We deliberately do NOT grant generic shell
# escalation; only the specific commands the access flow needs.
#
# %BOOMBOX_USER% is replaced by install.sh with the actual username.

%BOOMBOX_USER% ALL=(root) NOPASSWD: /usr/sbin/mopidyctl local scan
%BOOMBOX_USER% ALL=(root) NOPASSWD: /usr/bin/mopidyctl  local scan
%BOOMBOX_USER% ALL=(root) NOPASSWD: /bin/systemctl restart mopidy
%BOOMBOX_USER% ALL=(root) NOPASSWD: /usr/bin/systemctl restart mopidy

# Power button shutdown via boombox-buttons.service (user unit; needs explicit
# grant since polkit refuses for non-seat-attached user services). Reboot is
# included for the same auth domain — useful for future "reboot from UI" flows.
%BOOMBOX_USER% ALL=(root) NOPASSWD: /usr/bin/systemctl poweroff, /bin/systemctl poweroff
%BOOMBOX_USER% ALL=(root) NOPASSWD: /usr/bin/systemctl reboot,   /bin/systemctl reboot

# nginx reload from apply-release.sh after a release swap. The `install`
# entry is narrowly scoped — exact source path, exact destination — so the
# deploy can re-sync the snippet from the release tree without granting
# generic write to /etc/nginx.
%BOOMBOX_USER% ALL=(root) NOPASSWD: /usr/sbin/nginx -t, /bin/systemctl reload nginx, /usr/bin/systemctl reload nginx, /usr/bin/install -m 0644 /opt/boombox/current/install/config/nginx-boombox-common.conf /etc/nginx/snippets/boombox-common.conf

# First-run setup wizard (boombox-setup) privileged helper. The helper reads a
# single JSON command from stdin and applies it (device name/hostname, Wi-Fi
# join, Jellyfin target). It lives at a root-owned, non-user-writable path and
# takes NO arguments, so there is no argv-injection surface — every input is
# validated inside the root script. This is the only generic-ish escalation the
# boombox user gets, and it is bounded by that script's fixed action set.
%BOOMBOX_USER% ALL=(root) NOPASSWD: /usr/local/sbin/boombox-setup-apply

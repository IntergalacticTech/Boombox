[Unit]
Description=Boombox USB auto-mount for /dev/%I
BindsTo=dev-%i.device
After=dev-%i.device
StopWhenUnneeded=yes

[Service]
Type=oneshot
RemainAfterExit=yes
# %I is the systemd-unescaped instance name (e.g. "sda1"); we feed back
# /dev/sda1 to the script. The script is the ROOT-OWNED copy install.sh puts
# in /usr/local/sbin — never the release tree, which the (unprivileged)
# boombox user owns and could otherwise rewrite to run code as root.
ExecStart=/usr/local/sbin/boombox-usb-mount mount /dev/%I
ExecStop=/usr/local/sbin/boombox-usb-mount unmount /dev/%I
TimeoutStartSec=30
TimeoutStopSec=15

[Unit]
Description=Boombox wireless-remote HTTP API (REST + WebSocket)
After=graphical-session.target pipewire.service boombox-state.service
PartOf=graphical-session.target

[Service]
Type=simple
# Optional: supplies JELLYFIN_API_KEY and (for an off-device Jellyfin)
# BOOMBOX_JELLYFIN_BASE. The leading '-' makes it a no-op when absent.
EnvironmentFile=-/etc/boombox/jellyfin.env
ExecStart=/opt/boombox/.venv/bin/python /opt/boombox/current/services/boombox-remote.py
Restart=on-failure
RestartSec=3
# Listens on 127.0.0.1:6685 — exposed to the LAN by nginx as
# /api/remote/ and advertised over mDNS as _boombox._tcp.

[Install]
WantedBy=default.target

[Unit]
Description=Boombox uploader (LAN remote + file drop, PIN-gated)
After=default.target nginx.service

[Service]
Type=simple
Environment=BOOMBOX_UPLOADER_PORT=6683
ExecStart=/opt/boombox/.venv/bin/python /opt/boombox/services/boombox-uploader.py
# Clear the PIN file on stop so consumers can tell the service is down.
ExecStopPost=/bin/sh -c 'rm -f "$XDG_RUNTIME_DIR/boombox-uploader.pin"'
Restart=on-failure
RestartSec=3

# NOT enabled at boot — toggled from the touchscreen Settings drawer.
# `systemctl --user enable boombox-uploader` is intentionally not wired in install.sh.

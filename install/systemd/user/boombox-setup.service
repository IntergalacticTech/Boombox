# install/systemd/user/boombox-setup.service
[Unit]
Description=Boombox first-run setup wizard backend (HTTP API)
# A pure loopback HTTP backend like boombox-library — order it after
# default.target, NOT graphical-session. Ordering it after the other
# boombox-* services (which are themselves After=default.target /
# graphical-session) creates a start-up cycle that systemd breaks by
# dropping this unit at boot. The service degrades gracefully if
# boombox-library / boombox-remote aren't up yet (status wraps their
# calls; the kiosk gate retries), so it needs no ordering against them.
After=default.target network-online.target
Wants=network-online.target

[Service]
Type=simple
# LAN web port (for the QR URL shown on the kiosk). Optional; defaults to 8090.
EnvironmentFile=-/etc/boombox/web-auth.env
ExecStart=/opt/boombox/.venv/bin/python /opt/boombox/current/services/boombox-setup.py
Restart=on-failure
RestartSec=3
# Listens on 127.0.0.1:6689 — exposed to the kiosk (:80) and the LAN (:8090)
# by nginx as /api/setup/ with auth_basic off; mutating routes are gated by a
# setup token minted on the kiosk (shown as a QR) or a localhost origin.

[Install]
WantedBy=default.target

[Unit]
Description=Boombox Chromium kiosk
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
Environment=XDG_RUNTIME_DIR=/run/user/%U
Environment=WAYLAND_DISPLAY=wayland-0
# A hard-killed Chromium leaves Singleton* symlinks pointing at a dead PID,
# and the next launch refuses the "in-use" profile — crash-looping the kiosk
# on a black screen. This unit is the only thing that launches this profile,
# so clearing the locks before every start is always safe.
ExecStartPre=/bin/rm -f %h/.config/chromium/SingletonLock %h/.config/chromium/SingletonSocket %h/.config/chromium/SingletonCookie
## --app= + --start-maximized instead of --kiosk: --kiosk triggers
## xdg_toplevel.set_fullscreen on Wayland, and labwc raises fullscreen
## surfaces above the wlr_layer_shell overlay where wvkbd lives — i.e.
## the on-screen keyboard would never be visible. --app= is borderless
## but uses a plain xdg_toplevel, so the overlay layer wins.
##
## The boombox-kiosk-guard watchdog keeps the URL pinned to localhost,
## and Wayland compositors don't draw a title bar on Chromium's
## --app windows.
ExecStart=/usr/bin/chromium \
  --app=http://localhost/ \
  --start-maximized \
  --window-position=0,0 \
  --window-size=800,480 \
  --ozone-platform=wayland \
  --enable-features=UseOzonePlatform \
  --enable-wayland-ime \
  --wayland-text-input-version=3 \
  --remote-debugging-port=9222 \
  --remote-allow-origins=* \
  --noerrdialogs \
  --disable-session-crashed-bubble \
  --overscroll-history-navigation=0 \
  --password-store=basic \
  --no-first-run \
  --no-default-browser-check \
  --load-extension=/opt/boombox/current/install/kiosk-extension \
  --user-data-dir=%h/.config/chromium
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target

[Unit]
Description=Boombox on-screen keyboard (wvkbd, hidden until summoned)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# `--hidden` starts wvkbd as a Wayland surface that's collapsed to zero
# height. SIGUSR1 hides it, SIGUSR2 shows it. boombox-state's /api/osk
# endpoints + the kiosk extension's focus listeners drive the toggle.
#
# `--layer overlay` is the critical bit: Trixie's apt wvkbd is 0.15 and
# defaults to the layer-shell "top" layer, which sits below Chromium's
# --kiosk fullscreen surface. install.sh builds a current wvkbd from
# source into /usr/local/bin specifically so we can pass `--layer overlay`
# and have the keyboard render above the kiosk.
#
# Pi OS labwc doesn't integrate systemd-user with the desktop session env,
# so we point wvkbd at the Wayland socket explicitly — matches what the
# kiosk service does.
Environment=XDG_RUNTIME_DIR=/run/user/%U
Environment=WAYLAND_DISPLAY=wayland-0
ExecStart=/usr/local/bin/wvkbd-mobintl --hidden --layer overlay -H 280 -L 280
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target

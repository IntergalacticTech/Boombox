[Unit]
Description=Boombox auto-resume (Mopidy snapshot + restore)
# Snapshots of streamed Home Library tracks hold boombox-library's local
# proxy URLs (127.0.0.1:6687); order after it so a boot-time restore
# doesn't race it (boombox-resume.py also waits for the port).
After=network-online.target boombox-library.service
Wants=network-online.target boombox-library.service

[Service]
Type=simple
Environment=BOOMBOX_RESUME_FILE=%h/.local/state/boombox/last.json
ExecStartPre=/bin/mkdir -p %h/.local/state/boombox
ExecStart=/opt/boombox/.venv/bin/python /opt/boombox/current/services/boombox-resume.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target

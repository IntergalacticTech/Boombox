[Unit]
Description=Boombox audio visualizer (PipeWire monitor → /audio/ws)
After=graphical-session.target pipewire.service wireplumber.service
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/opt/boombox/.venv/bin/python /opt/boombox/current/services/boombox-audio.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target

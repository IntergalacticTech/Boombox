{
  "id": "tapeshift",
  "name": "Tape//Shift",
  "description": "Horizontal reel of sources/tracks · cassette-as-data",
  "palette": {
    "bg": "#161410",
    "panel": "#1f1c17",
    "panelHi": "#28241e",
    "ink": "#f3ece0",
    "ink2": "#a39684",
    "ink3": "#5e597a",
    "primary": "#ff7a35",
    "secondary": "#c8e44a",
    "accent": "#7fd9d4",
    "warn": "#ff5253",
    "rule": "rgba(243,236,224,0.10)",
    "ruleHi": "rgba(243,236,224,0.18)"
  },
  "fonts": {
    "display": "Space Grotesk",
    "mono": "JetBrains Mono"
  },
  "fontLicenses": {
    "Space Grotesk": {
      "license": "OFL-1.1",
      "url": "https://github.com/floriankarsten/space-grotesk"
    },
    "JetBrains Mono": {
      "license": "OFL-1.1",
      "url": "https://github.com/JetBrains/JetBrainsMono"
    }
  },
  "components": {
    "notes": "Component spacing/sizes are locked at the system level — these tokens describe color & font variants only.",
    "variants": {
      "button": [
        "transport-circle",
        "transport-square",
        "ghost",
        "primary"
      ],
      "meter": [
        "ascii",
        "bar-leds",
        "needle",
        "radial",
        "wave"
      ],
      "card": [
        "source-tile",
        "queue-row",
        "now-playing-hero"
      ]
    }
  }
}
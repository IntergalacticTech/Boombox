{
  "id": "boomos",
  "name": "Boom/OS",
  "description": "Retro desktop OS · beveled windows · pinstripe title bars · player as apps",
  "palette": {
    "desk": "#5f7d96",
    "win": "#d8d8d0",
    "winHi": "#efefe8",
    "winLo": "#8f8f86",
    "ink": "#1c1c1c",
    "ink2": "#55554e",
    "primary": "#2a4fd0",
    "primaryHi": "#93aef0"
  },
  "fonts": {
    "display": "Space Mono",
    "mono": "Space Mono"
  },
  "fontLicenses": {
    "Space Mono": {
      "license": "OFL-1.1",
      "url": "https://github.com/googlefonts/spacemono"
    }
  },
  "components": {
    "notes": "Component spacing/sizes are locked at the system level — these tokens describe color & font variants only.",
    "variants": {
      "button": [
        "bevel",
        "bevel-primary"
      ],
      "meter": [
        "segment-leds",
        "block-chars"
      ],
      "card": [
        "window",
        "window-inset"
      ]
    }
  }

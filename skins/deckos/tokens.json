{
  "id": "deckos",
  "name": "Deck//OS",
  "description": "Cyberpunk tape-deck terminal · phosphor green + magenta",
  "palette": {
    "bg": "#0a0e0c",
    "panel": "#0f1614",
    "panelHi": "#152120",
    "ink": "#9bf2c0",
    "ink2": "#5da78a",
    "ink3": "#2c4a3f",
    "primary": "#ff4fa8",
    "secondary": "#5be9ff",
    "accent": "#ffb84d",
    "warn": "#ff5566",
    "rule": "rgba(155,242,192,0.18)"
  },
  "fonts": {
    "display": "JetBrains Mono",
    "mono": "JetBrains Mono"
  },
  "fontLicenses": {
    "JetBrains Mono": {
      "license": "OFL-1.1",
      "url": "https://github.com/JetBrains/JetBrainsMono"
    }
  },
  "components": {
    "notes": "Component spacing/sizes are locked at the system level — these tokens describe color & font variants only.",
    "variants": {
      "button": [
        "transport-circle",
        "transport-square",
        "ghost",
        "primary"
      ],
      "meter": [
        "ascii",
        "bar-leds",
        "needle",
        "radial",
        "wave"
      ],
      "card": [
        "source-tile",
        "queue-row",
        "now-playing-hero"
      ]
    }
  }

# Per-developer Boombox config. Copy to .env (which is gitignored) and edit.
#
# Used by:
#   - ./pi  (the dev helper that wraps ssh / rsync / kiosk reload)
#   - ui/vite.config.ts (dev server proxy target)
#
# Both files auto-source this when present; no manual `export` needed.


# SSH access to the Pi.
#
# Either an alias from your ~/.ssh/config (recommended, see docs/ONBOARDING.md)
# or a plain user@host[:port].
BOOMBOX_HOST=boombox


# Where `npm run dev` proxies /mopidy, /api, and /audio to.
#
# Use the Pi's LAN IP plus the authenticated LAN web port:
# the request goes through the Pi's nginx, which then forwards
# /mopidy → Mopidy, /api → boombox-state, /audio → boombox-audio.
#
# Find the IP: `./pi ssh "hostname -I"`
BOOMBOX_DEV_TARGET=http://10.0.5.178:8090


# Remote web/SMB credential generated on the Pi by install.sh.
#
# Read it with: ./pi ssh "sudo cat /etc/boombox/web-auth.env"
# Vite injects this into proxy requests so local dev can still reach /api,
# /mopidy, and /audio after nginx requires auth for LAN clients.
BOOMBOX_WEB_USER=boombox
BOOMBOX_WEB_PASSWORD=123456


# --- Optional ---------------------------------------------------------------

# Chromium DevTools port on the Pi (rarely needs changing).
# BOOMBOX_DEBUG_PORT=9222

# Where ./pi shot saves screenshots locally.
# BOOMBOX_SHOTS_DIR=./screenshots

# Default URL for ./pi goto / ./pi restart-kiosk.
# KIOSK_URL=http://localhost/

# Boombox home media servers — environment.
#
#   cp .env.example .env   then edit the values below.
#
# This file (.env.example) is safe to commit. Your real .env is git-ignored —
# it holds credentials and host paths. NEVER commit .env or a tunnel token.

# ─────────────────────────────────────────────────────────────────────────
# Where your media physically lives ON THE HOST (absolute paths).
# These are bind-mounted read-only into the containers.
# ─────────────────────────────────────────────────────────────────────────
# Music library root — Navidrome scans this. Point it at your existing
# collection (the same tree you'd otherwise copy onto the boombox).
MUSIC_DIR=/srv/media/music

# Video library root — Jellyfin scans this. Movies should be named
# "Title (Year).ext" for the default Movies library to pick them up
# (see docs/VIDEO.md for the naming rules).
VIDEO_DIR=/srv/media/video

# ─────────────────────────────────────────────────────────────────────────
# Host user that owns the media + should own server state.
# Find yours with:  id -u   and   id -g
# ─────────────────────────────────────────────────────────────────────────
PUID=1000
PGID=1000

# IANA timezone, e.g. America/New_York, Europe/London. Affects scan
# schedules, logs, and "date added".
TZ=Etc/UTC

# ─────────────────────────────────────────────────────────────────────────
# Ports published on the host. Change if something else already uses them.
# Do NOT port-forward these raw HTTP ports to the internet — front them with
# TLS + auth (Cloudflare Tunnel overlay, or a reverse proxy). See
# docs/HOME-SERVERS.md.
# ─────────────────────────────────────────────────────────────────────────
NAVIDROME_PORT=4533
JELLYFIN_PORT=8096

# ─────────────────────────────────────────────────────────────────────────
# Admin credentials.
#
# Navidrome and Jellyfin BOTH create the first admin account through their
# own web wizard on first launch — there is no headless admin-seed env for
# them here. Open each server once and set a STRONG, UNIQUE password:
#   Navidrome:  http://<host>:4533
#   Jellyfin:   http://<host>:8096
#
# The boombox reuses a weak 6-digit LAN credential for its own on-device
# surface. Do NOT reuse that here. These servers may be internet-reachable;
# treat their passwords like any other internet-facing login.
# ─────────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────────────────
# External hostnames (only relevant once you expose the servers).
# Used to tell Jellyfin its public origin so it emits correct links.
# Leave blank for LAN-only. Example: https://video.example.com
# ─────────────────────────────────────────────────────────────────────────
JELLYFIN_PUBLISHED_URL=

# Your public music/video hostnames, for your own reference + the reverse
# proxy / tunnel config. The boombox points at MUSIC (Navidrome/Subsonic)
# and VIDEO (Jellyfin) via these once TLS is in front.
NAVIDROME_PUBLIC_HOST=music.example.com
JELLYFIN_PUBLIC_HOST=video.example.com

# ─────────────────────────────────────────────────────────────────────────
# Resource ceilings (optional — safe defaults for a shared host).
# ─────────────────────────────────────────────────────────────────────────
NAVIDROME_MEM_LIMIT=512m
JELLYFIN_MEM_LIMIT=2g

# ─────────────────────────────────────────────────────────────────────────
# Cloudflare Tunnel — ONLY needed if you use docker-compose.cloudflared.yml.
# Create a tunnel in the Cloudflare Zero Trust dashboard, map hostnames to
# http://navidrome:4533 and http://jellyfin:8096, and paste the token here.
# This is a SECRET — never commit it.
# ─────────────────────────────────────────────────────────────────────────
CLOUDFLARE_TUNNEL_TOKEN=
